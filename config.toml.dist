# Configuración de mpctui, con todas las opciones y sus valores por defecto.
#
# Copiar a ~/.config/mpctui/config.toml y ajustar lo que haga falta:
#
#     mkdir -p ~/.config/mpctui
#     cp config.toml.dist ~/.config/mpctui/config.toml
#
# Todo es opcional: una opción que no está toma su valor por defecto (el que figura
# acá). Un nombre de opción desconocido o un valor inválido no deja arrancar y se
# explica el motivo.
#
# Precedencia: valores por defecto < este archivo < variables de entorno
# (MPD_HOST, MPD_PORT, MPD_TIMEOUT, MPCTUI_GLYPHS y MPCTUI_COLORS).

# --- Servidor MPD --------------------------------------------------------------

# Host, ruta a un socket unix ("/run/mpd/socket") o "@nombre" para un socket
# abstracto de Linux. MPD_HOST lo reemplaza y admite "contraseña@host" y
# "contraseña@@nombre", como mpc.
# Sin host (ni acá ni en MPD_HOST), MPD se busca en este orden y se usa el primero
# que responde: $XDG_RUNTIME_DIR/mpd/socket, /run/mpd/socket y localhost:port.
# host = "localhost"

# Puerto TCP. MPD_PORT lo reemplaza.
port = 6600

# Contraseña de MPD, si el servidor la pide. Sin saltos de línea.
# password = "secreto"

# Cuánto se espera a MPD al conectar y en cada respuesta: lo fija MPD_TIMEOUT, en
# segundos enteros (por defecto 30). No es una opción de este archivo.

# --- Apariencia ----------------------------------------------------------------

# Idioma de la interfaz y de los mensajes de error: "en" (inglés) o "es" (español).
language = "en"

# Juego de glifos: "auto", "unicode" o "ascii".
# "auto" usa ASCII si el locale no es UTF-8 o si TERM es "linux" o "dumb".
# MPCTUI_GLYPHS lo reemplaza.
glyphs = "auto"

# Tema de colores: "terminal" (los 16 colores de la paleta de la terminal),
# "midnight" (frío), "vinyl" (cálido) o "neon" (synthwave). Los tres últimos están
# pensados para terminales oscuras y necesitan 256 colores; con 16 se usa
# "terminal". La tecla t pasa al siguiente sin guardarlo.
theme = "terminal"

# Profundidad de color: "auto", "truecolor", "256", "16" o "none".
# "auto": sin color si NO_COLOR tiene un valor o TERM es "dumb"; 24 bits si
# COLORTERM es "truecolor" o "24bit"; 256 si TERM incluye "256color"; si no, 16.
# MPCTUI_COLORS lo reemplaza. Sin color queda todo distinguible por los glifos,
# la negrita y el video inverso.
colors = "auto"

# Barras opcionales del panel "ahora suena" (la del tema siempre se muestra).
album_progress = false   # un segmento por tema del álbum en curso
queue_progress = false   # un segmento por álbum de la cola

# --- Visualizador (vista 6) ----------------------------------------------------

# Salida fifo de MPD que lee el visualizador. No puede estar vacía. Que no exista
# no es un error: la vista explica cómo crearla en mpd.conf.
visualizer_fifo = "/tmp/mpd.fifo"

# Formato de esa salida: debe coincidir con el "format" del audio_output fifo de
# mpd.conf. Solo 16 bits, 1 o 2 canales y entre 8000 y 192000 Hz.
visualizer_format = "44100:16:2"

# Forma con la que arranca la vista: "bars", "mirror", "wave", "waterfall",
# "vectorscope" o "meters". La tecla 6 pasa a la siguiente.
# "mirror" y "vectorscope" necesitan un formato de 2 canales.
visualizer_style = "bars"

# --- Letras (vista 7) ----------------------------------------------------------

[lyrics]

# false: no aparece la vista 7 y no se busca ninguna letra (ni archivos, ni MPD,
# ni la red).
enabled = true

# Fuentes en orden de búsqueda; gana la primera que tenga letra. Sin repetidos y,
# con las letras activadas, al menos una.
#   "cache"        directory/Artista - Título.lrc (o .txt)
#   "song_folder"  un .lrc/.txt junto al archivo del tema (necesita music_directory)
#   "tags"         la letra embebida en el archivo (FLAC y Ogg; en MP3 MPD no la expone)
#   "lrclib"       lrclib.net: envía artista, título, álbum y duración del tema
# Por defecto se usan todas; "song_folder" solo si se configuró music_directory.
# Sacar "lrclib" deja todo sin red; sacar "cache" evita escribir en disco.
sources = ["cache", "tags", "lrclib"]
# sources = ["cache", "song_folder", "tags", "lrclib"]

# Caché de letras: ahí se buscan y ahí se guardan las de LRCLIB. "~/" es el
# directorio del usuario. ~/.lyrics es la misma carpeta de ncmpcpp y ncmpc.
directory = "~/.lyrics"

# Raíz de la biblioteca de MPD (su music_directory). Solo la usa "song_folder":
# por TCP, MPD no informa dónde está la música.
# music_directory = "~/Music"

# true: busca la letra de cada tema que empieza aunque la vista 7 no esté abierta,
# así ya está lista al abrirla. Con "lrclib" en sources, cada tema que suena se
# consulta en lrclib.net (si no está en las fuentes anteriores).
fetch_in_background = false

# true: muestra la línea actual de una letra sincronizada en el panel "ahora
# suena", después del título. Implica buscar la letra de cada tema, como
# fetch_in_background.
now_playing_line = false
